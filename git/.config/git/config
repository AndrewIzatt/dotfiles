[init]
	defaultBranch = main
[user]
	name = Andrew Izatt
	email = izatt.andrew@gmail.com
[push]
	autoSetupRemote = true
[core]
	excludesfile = ~/.config/git/ignore
[pull]
	rebase = true
[rebase]
	autoStash = true
[lfs "customtransfer.xet"]
	path = git-xet
	args = transfer
	concurrent = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
