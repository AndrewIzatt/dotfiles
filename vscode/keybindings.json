// Place your key bindings in this file to override the defaults
[
    // Disables the default behavior where pressing Space selects or deselects items in list views (such as search results).
  {
    "key": "space",
    "command": "-list.toggleSelection",
  },
    // Disables the default behavior where pressing Space expands or collapses folders in the File Explorer.
  {
    "key": "space",
    "command": "-list.toggleExpand",
  },
  // allows you to hit exit which unfocuses and closes the side bar when in the search text input box
  {
    "key": "escape",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.closeSidebar",
        "workbench.action.focusActiveEditorGroup",
      ],
    },
    "when": "searchViewletFocus",
  },
`// Jump from File Explorer back to code without closing sidebar
  {
    "key": "escape",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "filesExplorerFocus && !inputFocus"
  },
  // Open and focus the File Explorer when in input window
  {
    "key": "space e",
    "command": "workbench.view.explorer",
    "when": "editorTextFocus && vim.mode == 'Normal'",
  },
    // Switch focus to File Explorer when in input window and it's already open
  {
    "key": "ctrl+h",
    "command": "workbench.files.action.focusFilesExplorer",
    "when": "editorTextFocus && vim.mode == 'Normal'"
  }
  {
    "key": "space e",
    "command": "workbench.action.closeSidebar",
    "when": "sideBarFocus && !inputFocus",
  },
    // Create a new file while in file explorer
  {

    "key": "a",
    "command": "explorer.newFile",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
    // Create a new folder while in file explorer
  {
    "key": "f",
    "command": "explorer.newFolder",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
    // Rename a file
  {
    "key": "r",
    "command": "renameFile",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
    // Cut a file
  {
    "key": "x",
    "command": "filesExplorer.cut",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
    // Copy a file
  {
    "key": "y",
    "command": "filesExplorer.copy",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !inputFocus",
  },
  {
    "key": "p",
    "command": "filesExplorer.paste",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "ctrl+e",
    "command": "workbench.action.toggleSidebarVisibility",
  },
  {
    "key": "j",
    "command": "list.focusDown",
    "when": "filesExplorerFocus && !inputFocus",
  },
  {
    "key": "k",
    "command": "list.focusUp",
    "when": "filesExplorerFocus && !inputFocus",
  },
  {
    "key": "l",
    "command": "list.expand",
    "when": "filesExplorerFocus && !inputFocus",
  },
  {
    "key": "h",
    "command": "list.collapse",
    "when": "filesExplorerFocus && !inputFocus",
  },
  {
    "key": "enter",
    "command": "list.select",
    "when": "filesExplorerFocus && !inputFocus",
  },
]
