{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
	"type": "small"
	},
  "modules": [
    "title",
    "separator",
    {
        "type": "os",
        "format": "{name} {codename} {version-id}"
    },
    {
        "type": "host",
        "format": "{family}"
    },
    "kernel",
    {
        "type": "wm",
        "format": "{pretty-name}"
    },
    {
        "type": "terminal",
        "format": "{pretty-name}"
    },
    "shell",
    "memory",
    "break",
    "colors"
  ]
}
